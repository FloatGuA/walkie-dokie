# 复制为 .env 并填入真实值，.env 不进 git

FEISHU_APP_ID=
FEISHU_APP_SECRET=

ANTHROPIC_API_KEY=

DEEPSEEK_API_KEY=

# 合同智能本地管理 Web。开发环境默认只监听 localhost；生产必须换强随机 SECRET。
CONTRACT_ADMIN_SECRET_KEY=
CONTRACT_ADMIN_DEBUG=1
CONTRACT_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost

# 默认使用 var/contract-intelligence/admin.db。切 PostgreSQL 时再开启以下配置。
CONTRACT_DB_ENGINE=sqlite
CONTRACT_DB_NAME=
CONTRACT_DB_USER=
CONTRACT_DB_PASSWORD=
CONTRACT_DB_HOST=127.0.0.1
CONTRACT_DB_PORT=5432
